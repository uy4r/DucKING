<Window x:Class="DucKING.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:DucKING.Core"
        Title="DucKING" Icon="Assets/ducking.ico" Width="1180" Height="800" MinWidth="980" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI" TextOptions.TextFormattingMode="Display">
    <Grid>
        <DockPanel>
            <!-- 1. katman: ince marka şeridi -->
            <Border DockPanel.Dock="Top" Height="40" Background="#0D0D10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="16,0,10,0">
                    <Button Style="{StaticResource IconButton}" HorizontalAlignment="Left" VerticalAlignment="Center" Click="Home_Click"
                            AutomationProperties.Name="{core:Loc main.homeName}" Padding="4,2">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="Assets/ducking.ico" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,8,0" />
                            <TextBlock VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Text}">
                                <Run Text="Duc" /><Run Text="KING" Foreground="{StaticResource Accent}" />
                            </TextBlock>
                            <TextBlock Text="{core:Loc main.tagline}" VerticalAlignment="Center" FontSize="11.5" Foreground="{StaticResource TextFaint}" Margin="10,1,0,0" />
                        </StackPanel>
                    </Button>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock VerticalAlignment="Center" FontSize="11.5" Foreground="{StaticResource TextDim}" Margin="0,0,12,0">
                            <Run x:Name="ElevationDot" Text="●" Foreground="{StaticResource Success}" /><Run Text=" " /><Run x:Name="ElevationText" Text="{core:Loc main.admin}" />
                        </TextBlock>
                        <TextBlock x:Name="VersionText" VerticalAlignment="Center" FontSize="11.5" Foreground="{StaticResource TextFaint}" Margin="0,0,4,0" />
                        <Button x:Name="LanguageButton" Style="{StaticResource IconButton}" Click="Language_Click" Padding="8,4"
                                ToolTip="{core:Loc main.language}" AutomationProperties.Name="{core:Loc main.language}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xF2B7;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" />
                                <TextBlock x:Name="LanguageCode" FontSize="11.5" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Click="About_Click" ToolTip="{core:Loc main.about}" AutomationProperties.Name="{core:Loc main.about}" Padding="8,4">
                            <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="13" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. katman: geniş sekmeler ve canlı durum rozetleri -->
            <Border DockPanel.Dock="Top" Height="50" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal" Margin="8,0,0,0">
                    <Button x:Name="HomePill" Style="{StaticResource NavTab}" Content="{core:Loc nav.home}" Click="Home_Click" />
                    <Button x:Name="GamesPill" Style="{StaticResource NavTab}" Click="Games_Click" AutomationProperties.Name="{core:Loc nav.games}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{core:Loc nav.games}" VerticalAlignment="Center" />
                            <Border x:Name="GamesBadge" Style="{StaticResource TabBadge}" Visibility="Collapsed">
                                <TextBlock x:Name="GamesBadgeText" FontSize="10.5" Foreground="{StaticResource TextDim}" />
                            </Border>
                        </StackPanel>
                    </Button>
                    <Button x:Name="HardwarePill" Style="{StaticResource NavTab}" Click="Hardware_Click" AutomationProperties.Name="{core:Loc nav.hardware}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{core:Loc nav.hardware}" VerticalAlignment="Center" />
                            <TextBlock x:Name="GpuTempBadge" FontSize="11" Margin="8,1,0,0" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextDim}" ToolTip="{core:Loc main.gpuTemp}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="NetPill" Style="{StaticResource NavTab}" Click="Net_Click" AutomationProperties.Name="{core:Loc nav.network}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{core:Loc nav.network}" VerticalAlignment="Center" />
                            <TextBlock x:Name="NetDot" Text="●" FontSize="9" Margin="7,1,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextFaint}" />
                            <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="9" Margin="7,2,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="SystemPill" Style="{StaticResource NavTab}" Click="System_Click" AutomationProperties.Name="{core:Loc nav.system}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{core:Loc nav.system}" VerticalAlignment="Center" />
                            <Border x:Name="SystemBadge" Style="{StaticResource TabBadge}" Background="{StaticResource AccentSoft}" Visibility="Collapsed"
                                    ToolTip="{core:Loc main.systemBadge}">
                                <TextBlock x:Name="SystemBadgeText" FontSize="10.5" Foreground="{StaticResource Danger}" />
                            </Border>
                            <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="9" Margin="7,2,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <ContentControl x:Name="PageHost" Focusable="False" />
        </DockPanel>

        <!-- Ağ açılır menüsü -->
        <Popup x:Name="NetMenu" Closed="NetMenu_Closed" PlacementTarget="{Binding ElementName=NetPill}" Placement="Bottom" VerticalOffset="10"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Width="270" Padding="6" CornerRadius="12" Background="{StaticResource Surface2}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                    <Button x:Name="DnsRow" Style="{StaticResource MenuRow}" Click="Dns_Click">
                        <Grid>
                            <TextBlock><Run Text="&#xE774;" FontFamily="{StaticResource IconFont}" /><Run Text="   " /><Run Text="{core:Loc nav.dns}" /></TextBlock>
                            <TextBlock x:Name="DnsMenuInfo" HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource TextDim}" />
                        </Grid>
                    </Button>
                    <Button x:Name="DpiRow" Style="{StaticResource MenuRow}" Click="Dpi_Click">
                        <Grid>
                            <TextBlock><Run Text="&#xE785;" FontFamily="{StaticResource IconFont}" /><Run Text="   " /><Run Text="{core:Loc nav.dpi}" /></TextBlock>
                            <TextBlock x:Name="DpiMenuInfo" HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource TextDim}" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Border>
        </Popup>

        <!-- Sistem açılır menüsü -->
        <Popup x:Name="SystemMenu" Closed="SystemMenu_Closed" PlacementTarget="{Binding ElementName=SystemPill}" Placement="Bottom" VerticalOffset="10"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Width="270" Padding="6" CornerRadius="12" Background="{StaticResource Surface2}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                    <Button x:Name="PerformanceRow" Style="{StaticResource MenuRow}" Click="Performance_Click">
                        <TextBlock><Run Text="&#xE945;" FontFamily="{StaticResource IconFont}" /><Run Text="   " /><Run Text="{core:Loc nav.performance}" /></TextBlock>
                    </Button>
                    <Button x:Name="PrivacyRow" Style="{StaticResource MenuRow}" Click="Privacy_Click">
                        <TextBlock><Run Text="&#xE733;" FontFamily="{StaticResource IconFont}" /><Run Text="   " /><Run Text="{core:Loc nav.privacy}" /></TextBlock>
                    </Button>
                    <Button x:Name="StartupRow" Style="{StaticResource MenuRow}" Click="Startup_Click">
                        <TextBlock><Run Text="&#xE7E8;" FontFamily="{StaticResource IconFont}" /><Run Text="   " /><Run Text="{core:Loc nav.startup}" /></TextBlock>
                    </Button>
                    <Button x:Name="AppsRow" Style="{StaticResource MenuRow}" Click="Apps_Click">
                        <TextBlock><Run Text="&#xE71D;" FontFamily="{StaticResource IconFont}" /><Run Text="   " /><Run Text="{core:Loc nav.apps}" /></TextBlock>
                    </Button>
                </StackPanel>
            </Border>
        </Popup>

        <!-- Dil seçimi -->
        <Popup x:Name="LanguageMenu" Closed="LanguageMenu_Closed" PlacementTarget="{Binding ElementName=LanguageButton}" Placement="Bottom"
               VerticalOffset="6" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Width="180" Padding="6" CornerRadius="12" Background="{StaticResource Surface2}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <StackPanel x:Name="LanguageList" />
            </Border>
        </Popup>

        <!-- Bildirim -->
        <Border x:Name="Toast" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="24" Padding="16,11" CornerRadius="12" MaxWidth="640"
                Background="{StaticResource Surface2}" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.6" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="ToastIcon" FontFamily="{StaticResource IconFont}" FontSize="15" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock x:Name="ToastText" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="580" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
