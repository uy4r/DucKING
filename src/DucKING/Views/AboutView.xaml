<UserControl x:Class="DucKING.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:DucKING.Core">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,30,44,30">
            <TextBlock Text="{core:Loc main.about}" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="{core:Loc about.subtitle}" />

            <!-- UpdateChecker.Repository boşken gizlenir. -->
            <WrapPanel x:Name="UpdatePanel" Margin="0,16,0,0">
                <Button x:Name="CheckUpdateButton" Content="{core:Loc about.checkUpdates}" Margin="0,0,14,0" Click="CheckUpdate_Click" />
                <TextBlock x:Name="UpdateStatus" Style="{StaticResource Dim}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <Button x:Name="ReleaseButton" Content="{core:Loc about.openRelease}" Style="{StaticResource LinkButton}"
                        VerticalAlignment="Center" Visibility="Collapsed" Click="Release_Click" />
            </WrapPanel>

            <ItemsControl x:Name="Credits" Margin="0,22,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="18,11">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource SectionTitle}" FontSize="14" />
                                    <TextBlock Text="{Binding Usage}" Style="{StaticResource Dim}" Margin="0,3,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding License}" FontSize="11.5" Foreground="{StaticResource TextDim}" HorizontalAlignment="Right" />
                                    <Button Content="{Binding Url}" Tag="{Binding Url}" Style="{StaticResource LinkButton}" Click="Link_Click" Margin="0,3,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{core:Loc about.troubleshooting}" Style="{StaticResource SectionTitle}" Margin="0,22,0,10" />
            <WrapPanel>
                <Button Content="{core:Loc about.openLog}" Margin="0,0,10,0" Click="OpenLog_Click" />
                <Button Content="{core:Loc about.openData}" Margin="0,0,10,0" Click="OpenData_Click" />
                <Button Content="{core:Loc about.licenses}" Margin="0,0,10,0" Click="OpenLicenses_Click" />
                <Button x:Name="ReportButton" Content="{core:Loc about.diagnostics}" Click="Report_Click" />
            </WrapPanel>
            <TextBlock Style="{StaticResource Dim}" Margin="0,12,0,0"
                       Text="{core:Loc about.diagnosticsNote}" />
            <TextBlock Style="{StaticResource Dim}" Margin="0,12,0,0"
                       Text="{core:Loc about.backupNote}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
