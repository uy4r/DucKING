<UserControl x:Class="DucKING.Views.AppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:DucKING.Core">
    <DockPanel Margin="36,30,36,0">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{core:Loc apps.title}" Style="{StaticResource PageTitle}" />
                <TextBlock Style="{StaticResource PageSubtitle}"
                           Text="{core:Loc apps.subtitle}" />
                <TextBlock x:Name="StatusText" Style="{StaticResource Dim}" Margin="0,10,0,0" Foreground="{StaticResource Accent}" />
            </StackPanel>
            <Button Grid.Column="1" x:Name="RemoveButton" Content="{core:Loc apps.removeSelected}" Style="{StaticResource PrimaryButton}"
                    VerticalAlignment="Bottom" Click="Remove_Click" />
        </Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <ItemsControl x:Name="List" Margin="0,0,0,24">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" VerticalAlignment="Top" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,10,10" Padding="16,12">
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5" Foreground="{StaticResource Text}" />
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Dim}" Margin="0,3,0,0" />
                                </StackPanel>
                            </CheckBox>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
