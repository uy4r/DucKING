<UserControl x:Class="DucKING.Views.HardwareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:DucKING.Core"
             Loaded="OnLoaded" Unloaded="OnUnloaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,24,36,30">
            <TextBlock Text="{core:Loc nav.hardware}" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="{core:Loc hw.subtitle}" />

            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Ekran kartı -->
                <Border Style="{StaticResource Card}" Background="#1A0B0D" BorderBrush="{StaticResource AccentLine}" CornerRadius="14" Padding="20,16">
                    <StackPanel>
                        <TextBlock Text="{core:Loc home.gpu}" FontSize="13" Foreground="{StaticResource Danger}" />
                        <TextBlock x:Name="GpuName" Text="…" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{core:Loc hw.temp}" Style="{StaticResource TileLabel}" />
                                <TextBlock Style="{StaticResource TileValue}" FontSize="34"><Run x:Name="GpuTemp" Text="—" /><Run Text=" °C" FontSize="16" Foreground="{StaticResource TextFaint}" /></TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{core:Loc hw.usage}" Style="{StaticResource TileLabel}" />
                                <TextBlock Style="{StaticResource TileValue}" FontSize="34"><Run x:Name="GpuUsage" Text="—" /><Run Text=" %" FontSize="16" Foreground="{StaticResource TextFaint}" /></TextBlock>
                            </StackPanel>
                        </Grid>
                        <Canvas x:Name="GpuChart" Height="90" Margin="0,10,0,4" ClipToBounds="True" SizeChanged="Chart_SizeChanged">
                            <Path x:Name="GpuUsagePath" Stroke="#7A3A40" StrokeThickness="2" StrokeLineJoin="Round" />
                            <Path x:Name="GpuTempPath" Stroke="{StaticResource Accent}" StrokeThickness="2" StrokeLineJoin="Round" />
                        </Canvas>
                        <TextBlock FontSize="11" Foreground="{StaticResource TextFaint}">
                            <Run Text="━ " Foreground="{StaticResource Accent}" /><Run Text="{core:Loc hw.legendTemp}" Foreground="{StaticResource Accent}" /><Run Text="    ━ " Foreground="#7A3A40" /><Run Text="{core:Loc hw.legendUsage}" Foreground="#7A3A40" /><Run Text="    " /><Run Text="{core:Loc hw.legendWindow}" />
                        </TextBlock>
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="VRAM" Style="{StaticResource TileLabel}" />
                                <TextBlock x:Name="GpuVram" Text="—" FontSize="15" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{core:Loc hw.fan}" Style="{StaticResource TileLabel}" />
                                <TextBlock x:Name="GpuFan" Text="—" FontSize="15" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{core:Loc hw.power}" Style="{StaticResource TileLabel}" />
                                <TextBlock x:Name="GpuPower" Text="—" FontSize="15" Margin="0,3,0,0" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="2">
                    <!-- İşlemci -->
                    <Border Style="{StaticResource Card}" CornerRadius="14" Padding="20,16">
                        <StackPanel>
                            <TextBlock Text="{core:Loc home.cpu}" Style="{StaticResource TileLabel}" />
                            <TextBlock x:Name="CpuName" Text="…" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{core:Loc hw.usage}" Style="{StaticResource TileLabel}" />
                                    <TextBlock Style="{StaticResource TileValue}"><Run x:Name="CpuUsage" Text="—" /><Run Text=" %" FontSize="14" Foreground="{StaticResource TextFaint}" /></TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{core:Loc hw.clock}" Style="{StaticResource TileLabel}" />
                                    <TextBlock Style="{StaticResource TileValue}"><Run x:Name="CpuClock" Text="—" /><Run Text=" " FontSize="14" /><Run Text="{core:Loc unit.ghz}" FontSize="14" Foreground="{StaticResource TextFaint}" /></TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{core:Loc hw.temp}" Style="{StaticResource TileLabel}" />
                                    <TextBlock Style="{StaticResource TileValue}" Text="—" Foreground="{StaticResource TextFaint}"
                                               ToolTip="{core:Loc hw.cpuTempTip}" />
                                </StackPanel>
                            </Grid>
                            <Canvas x:Name="CpuChart" Height="60" Margin="0,10,0,0" ClipToBounds="True" SizeChanged="Chart_SizeChanged">
                                <Path x:Name="CpuPath" Stroke="{StaticResource Accent}" StrokeThickness="2" StrokeLineJoin="Round" />
                            </Canvas>
                            <TextBlock Style="{StaticResource Dim}" FontSize="11.5" Margin="0,8,0,0"
                                       Text="{core:Loc hw.cpuTempNote}" />
                        </StackPanel>
                    </Border>

                    <!-- Bellek -->
                    <Border Style="{StaticResource Card}" CornerRadius="14" Padding="20,16" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="{core:Loc hw.ram}" Style="{StaticResource TileLabel}" />
                            <TextBlock Style="{StaticResource TileValue}"><Run x:Name="RamUsed" Text="—" /><Run x:Name="RamTotal" FontSize="14" Foreground="{StaticResource TextFaint}" /></TextBlock>
                            <Grid Height="6" Margin="0,10,0,0">
                                <Border CornerRadius="3" Background="{StaticResource Surface2}" />
                                <Border x:Name="RamBar" CornerRadius="3" Background="{StaticResource Accent}" RenderTransformOrigin="0,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleX="0" />
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
