<UserControl x:Class="DucKING.Views.TweaksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:DucKING.Core">
    <DockPanel Margin="36,30,36,0">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="TitleText" Style="{StaticResource PageTitle}" />
                <TextBlock x:Name="SubtitleText" Style="{StaticResource PageSubtitle}" />
                <TextBlock x:Name="CountText" Style="{StaticResource Dim}" Margin="0,10,0,0" Foreground="{StaticResource Accent}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button x:Name="RevertButton" Content="{core:Loc tweaks.revertAll}" Margin="0,0,10,0" Click="Revert_Click" />
                <Button x:Name="ApplyButton" Content="{core:Loc tweaks.applyRecommended}" Style="{StaticResource PrimaryButton}" Click="Apply_Click" />
            </StackPanel>
        </Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <ItemsControl x:Name="List" ItemTemplate="{StaticResource TweakTemplate}" Margin="0,0,0,24" />
        </ScrollViewer>
    </DockPanel>
</UserControl>
